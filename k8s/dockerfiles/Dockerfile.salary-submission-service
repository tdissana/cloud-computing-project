# ── Stage 1: Build ───────────────────────────────────────────────────
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build

# Copy parent pom (required by child module's <parent> reference)
COPY pom.xml ./

WORKDIR /build/salary-submission-service
COPY salary-submission-service/.mvn/ .mvn/
COPY salary-submission-service/mvnw salary-submission-service/pom.xml ./
RUN chmod +x mvnw && ./mvnw dependency:go-offline -q

# Copy source and build (skip tests — tests run in CI)
COPY salary-submission-service/src/ src/
RUN ./mvnw package -DskipTests -q

# ── Stage 2: Runtime ──────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S watupa && adduser -S watupa -G watupa
USER watupa

COPY --from=builder /build/salary-submission-service/target/*.jar app.jar

ENV JAVA_OPTS="-XX:MaxRAMPercentage=60.0 -XX:+UseContainerSupport -XX:MetaspaceSize=64m -XX:MaxMetaspaceSize=128m"

EXPOSE 8082
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
