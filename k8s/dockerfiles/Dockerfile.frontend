# ── Stage 1: Dependencies ─────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# ── Stage 2: Build ────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Tell Next.js the API prefix routes via Traefik to the BFF
ENV NEXT_PUBLIC_API_URL=""
ENV NODE_ENV=production

RUN npm run build

# ── Stage 3: Runtime ──────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup -S watupa && adduser -S watupa -G watupa

# Only copy what Next.js needs at runtime
COPY --from=builder /app/public ./public
COPY --from=builder --chown=watupa:watupa /app/.next/standalone ./
COPY --from=builder --chown=watupa:watupa /app/.next/static ./.next/static

USER watupa

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
