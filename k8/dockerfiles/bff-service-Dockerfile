# Multi-stage build for bff-service
FROM maven:3.9.6-openjdk-21-slim AS build
WORKDIR /app
COPY backend/pom.xml .
COPY backend/bff-service/pom.xml bff-service/
RUN mvn dependency:go-offline -B
COPY backend/bff-service/src bff-service/src
RUN mvn clean package -DskipTests -pl bff-service

FROM openjdk:21-jre-slim
WORKDIR /app
COPY --from=build /app/bff-service/target/bff-service-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8000
ENTRYPOINT ["java", "-jar", "app.jar"]
