# Multi-stage build for stats-service
FROM maven:3.9.6-openjdk-21-slim AS build
WORKDIR /app
COPY backend/pom.xml .
COPY backend/stats-service/pom.xml stats-service/
RUN mvn dependency:go-offline -B
COPY backend/stats-service/src stats-service/src
RUN mvn clean package -DskipTests -pl stats-service

FROM openjdk:21-jre-slim
WORKDIR /app
COPY --from=build /app/stats-service/target/stats-service-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8004
ENTRYPOINT ["java", "-jar", "app.jar"]
