# Multi-stage build for salary-submission-service
FROM maven:3.9.6-openjdk-21-slim AS build
WORKDIR /app
COPY backend/pom.xml .
COPY backend/salary-submission-service/pom.xml salary-submission-service/
RUN mvn dependency:go-offline -B
COPY backend/salary-submission-service/src salary-submission-service/src
RUN mvn clean package -DskipTests -pl salary-submission-service

FROM openjdk:21-jre-slim
WORKDIR /app
COPY --from=build /app/salary-submission-service/target/salary-submission-service-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8002
ENTRYPOINT ["java", "-jar", "app.jar"]
